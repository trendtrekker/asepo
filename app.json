{
  "expo": {
    "name": "Asepo",
    "slug": "asepo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand-icon.png",
    "scheme": "asepo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.asepo.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Asepo uses your camera to scan recipe cards and cookbook pages.",
        "NSPhotoLibraryUsageDescription": "Asepo needs access to your photos to import a recipe from a screenshot."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B2C43",
        "foregroundImage": "./assets/images/brand-icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.asepo.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B2C43",
          "image": "./assets/images/brand-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Asepo needs access to your photos to import a recipe from a screenshot.",
          "cameraPermission": "Asepo uses your camera to scan recipe cards and cookbook pages.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/brand-icon.png",
          "color": "#C2410C"
        }
      ],
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c257c9bb-0f87-40d4-9620-739967f2f6b1"
      }
    },
    "owner": "vawahs-team"
  }
}
