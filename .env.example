# Copy to .env and fill in to point the app at your backend.
# Leave unset and the app runs entirely on sample data (src/lib/api/fixtures.ts).
#
# This must be YOUR server, not https://api.kie.ai — the kie.ai key lives on the
# backend and must never be bundled into the app. Anything prefixed with
# EXPO_PUBLIC_ is embedded in the JS bundle and readable by anyone with the app.
EXPO_PUBLIC_API_URL=

# Supabase project URL and anon (public) key — Project Settings -> API.
# Safe to be public: Row Level Security policies are what actually restrict
# access, not secrecy of this key. Never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys — one for each store app. These are safe to bundle.
# RevenueCat dashboard -> Project settings -> API keys.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Do NOT add your kie.ai key here. It belongs in the backend's own environment:
#   KIE_API_KEY=...        (server-side only)
