# Copy to server/.env and fill in. This file stays on the server; never ship it
# to the app, and never commit the real .env (it is gitignored).

# Your kie.ai API key — https://kie.ai
KIE_API_KEY=

# Port the server listens on
PORT=8787

# Public origin used to build image URLs. Must be reachable by your phone, so
# on a LAN use your machine's IP, e.g. http://192.168.1.195:8787
PUBLIC_URL=http://localhost:8787
