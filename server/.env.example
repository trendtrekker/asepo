# Copy to server/.env and fill in. This file stays on the server; never ship it
# to the app, and never commit the real .env (it is gitignored).

# Your kie.ai API key — https://kie.ai
KIE_API_KEY=

PORT=8787

# Public origin used to build image URLs. Must be reachable by your phone, so
# on a LAN use your machine's IP, e.g. http://192.168.1.195:8787
PUBLIC_URL=http://localhost:8787

# --- Supabase --------------------------------------------------------------
# Project Settings -> API. SERVICE_ROLE_KEY bypasses RLS — never expose it to
# the app, only used here for admin-only operations (deleting an account,
# re-hosting images into the recipe-photos bucket).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used only by scripts/apply-migration.mjs
# and scripts/db-test.mjs — not needed for the running server itself.
# Project Settings -> Database -> Connection string (URI).
SUPABASE_DB_URL=

# --- LLM used to extract recipes from captions and prose ----------------------
# Defaults below are verified working against kie.ai. Model ids use hyphens:
# "gpt-5-5", not "gpt-5.5".
#
#   LLM_PROTOCOL=responses  -> POST {base}/responses      gpt-5-5, gpt-5-4, grok-4-5
#   LLM_PROTOCOL=messages   -> POST {base}/messages       claude-fable-5
#                              (base https://api.kie.ai/claude/v1)
#   LLM_PROTOCOL=chat       -> POST {base}/chat/completions  for OpenAI/OpenRouter
#
# LLM_BASE_URL=https://api.kie.ai/codex/v1
# LLM_MODEL=gpt-5-5
# LLM_PROTOCOL=responses
# LLM_API_KEY=            # falls back to KIE_API_KEY when unset
